{
  "name": "language-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm start",
    "start": "node server/start.mjs",
    "build": "tsc --noEmit && vite build",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "curriculum:check": "vitest run tests/content-packs.test.ts tests/curriculum.test.ts tests/curriculum-inventory.test.ts tests/pedagogy.test.ts tests/personal-path.test.ts tests/spanish.test.ts",
    "curriculum:report": "vitest run --no-file-parallelism --disableConsoleIntercept tests/content-packs.test.ts tests/curriculum-inventory.test.ts tests/personal-path.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "curriculum:audio": "node scripts/curriculum-audio.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "dexie": "^4.4.7",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {},
    "minimatch": "11.0.1"
  }
}
