        "startMs": 8435,
        "endMs": 14551,
        "text": "Thanks. I checked the form this morning. It looks clear, and the volunteers should be able to use it right away."
      },
      {
        "role": "B1-sender",
        "startMs": 14931,
        "endMs": 18536,
        "text": "Great. I’ll write a short message with the link before I send it."
      },
      {
        "role": "B2-colleague",
        "startMs": 18916,
        "endMs": 21817,
        "text": "Sounds good. Let me know if you need help with the message."
      }
