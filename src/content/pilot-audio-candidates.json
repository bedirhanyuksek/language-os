    "transcript": [
      {
        "role": "A1-updater",
        "startMs": 0,
        "endMs": 6100,
        "text": "Here’s a quick update. We’ve fixed the payment issue. We fixed it on Tuesday, and the page is working again."
      },
      {
        "role": "A2-tester",
        "startMs": 6480,
        "endMs": 13240,
        "text": "Good to hear. I’m going to test the payment page again tomorrow. I’ll check that a customer can complete a payment."
      },
      {
        "role": "A1-updater",
        "startMs": 13620,
        "endMs": 18912,
        "text": "Thanks. Please let me know how the test goes. I’ll update the rest of the team after I hear from you."
      },
      {
        "role": "A2-tester",
        "startMs": 19292,
        "endMs": 21870,
        "text": "Sure. I’ll send you the result after the test."
      }
    ],
