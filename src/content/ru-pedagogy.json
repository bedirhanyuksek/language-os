          {
            "title": "Ad kalıbını bir bütün olarak öğren",
            "explanation": "Меня́ зову́т + ad kalıbında меня́, я zamirinin belirtme hâlidir. Türkçedeki “benim adım” ile aynı iletişim işini görür. İlk aşamada çekim tablosuna girmeden kalıbı kullan.",
            "example": "Меня́ зову́т Ди́ма."
          },
          {
            "title": "Kibar hitabı seç",
            "explanation": "Bir yetişkine veya yeni tanıştığın birine Здра́вствуйте ve Как вас зову́т? diyebilirsin. Arkadaşına Как тебя́ зову́т? denebilir. Aynı soru, ilişkiye göre farklı hitap taşır.",
            "example": "Здра́вствуйте! Как вас зову́т? — Меня́ зову́т И́ра."
          }
        ],
        "rubric": [
          {
            "criterion": "Adını kalıpla söyle",
            "example": "Меня́ зову́т Ле́на."
          },
          {
            "criterion": "Uygun hitapla ad sor",
            "example": "Как вас зову́т?"
          }
        ],
